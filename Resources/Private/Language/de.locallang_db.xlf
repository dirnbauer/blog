    <unit id="plugin.blog_authors.title">
      <segment>
        <source>Blog: Authors</source>
        <target>Blog: Autoren</target>
      </segment>
    </unit>
    <unit id="plugin.blog_authors.description">
      <segment>
        <source>Displays post authors, like name, title, avatar, social links...</source>
        <target>Zeigt Beitragsautoren mit Name, Titel, Avatar und Social Links.</target>
      </segment>
    </unit>
    <unit id="plugin.blog_relatedposts.title">
      <segment>
        <source>Blog: Related Posts</source>
        <target>Blog: Ähnliche Beiträge</target>
      </segment>
    </unit>
    <unit id="plugin.blog_relatedposts.description">
      <segment>
        <source>Based on the categories and tags of the current post, it will show a list of related posts. This overview should only be placed on a Blog detail page.</source>
        <target>Basierend auf Kategorien und Schlagwörtern des aktuellen Beitrags wird eine Liste ahnlicher Beiträge angezeigt. Diese Übersicht sollte nur auf einer Blog-Detailseite platziert werden.</target>
      </segment>
    </unit>
