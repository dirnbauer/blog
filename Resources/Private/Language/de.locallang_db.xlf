    <unit id="plugin.blog_posts.title">
      <segment>
        <source>Blog: List of posts</source>
        <target>Blog: Beitragsliste</target>
      </segment>
    </unit>
    <unit id="plugin.blog_posts.description">
      <segment>
        <source>Displays a list of blog posts ordered by date. All non-hidden, non-deleted and non-archived posts are shown in the list.</source>
        <target>Zeigt eine nach Datum sortierte Liste der Blogbeiträge. Alle nicht verborgenen, nicht gelöschten und nicht archivierten Beiträge werden angezeigt.</target>
      </segment>
    </unit>
    <unit id="plugin.blog_demandedposts.title">
      <segment>
        <source>Blog: List of posts by demand configuration</source>
        <target>Blog: Beitragsliste nach Bedarfskonfiguration</target>
      </segment>
    </unit>
    <unit id="plugin.blog_demandedposts.description">
      <segment>
        <source>Displays a list of blog posts depending on your demand configuration.</source>
        <target>Zeigt eine Liste von Blogbeiträgen entsprechend Ihrer Bedarfskonfiguration.</target>
      </segment>
    </unit>
    <unit id="plugin.blog_latestposts.title">
      <segment>
        <source>Blog: Latest posts</source>
        <target>Blog: Neueste Beiträge</target>
      </segment>
    </unit>
    <unit id="plugin.blog_latestposts.description">
      <segment>
        <source>Displays a number of latest posts. You can specify the amount of items yourself.</source>
        <target>Zeigt eine Anzahl der neuesten Beiträge. Die Anzahl der Einträge können Sie selbst festlegen.</target>
      </segment>
    </unit>
    <unit id="plugin.blog_category.title">
      <segment>
        <source>Blog: List by category</source>
        <target>Blog: Liste nach Kategorie</target>
      </segment>
    </unit>
    <unit id="plugin.blog_category.description">
      <segment>
        <source>If you add this element and you have selected a category on the categories tab, it will show an overview of posts for that category. If you have no categories selected, it will show an overview of categories.</source>
        <target>Wenn Sie dieses Element hinzufügen und im Tab Kategorien eine Kategorie ausgewählt haben, zeigt es eine Übersicht der Beiträge für diese Kategorie. Ohne ausgewählte Kategorie wird eine Kategorienübersicht angezeigt.</target>
      </segment>
    </unit>
    <unit id="plugin.blog_authorposts.title">
      <segment>
        <source>Blog: List by author</source>
        <target>Blog: Liste nach Autor</target>
      </segment>
    </unit>
    <unit id="plugin.blog_authorposts.description">
      <segment>
        <source>Displays all posts belonging to the chosen author.</source>
        <target>Zeigt alle Beiträge des ausgewählten Autors.</target>
      </segment>
    </unit>
    <unit id="plugin.blog_tag.title">
      <segment>
        <source>Blog: List by tags</source>
        <target>Blog: Liste nach Schlagwörtern</target>
      </segment>
    </unit>
    <unit id="plugin.blog_tag.description">
      <segment>
        <source>Allows the users to show all posts tagged with a specific keyword.</source>
        <target>Ermöglicht Benutzern, alle Beiträge mit einem bestimmten Schlagwort anzuzeigen.</target>
      </segment>
    </unit>
    <unit id="plugin.blog_archive.title">
      <segment>
        <source>Blog: Archive</source>
        <target>Blog: Archiv</target>
      </segment>
    </unit>
    <unit id="plugin.blog_archive.description">
      <segment>
        <source>The archive plugin displays all posts categorized by year and month.</source>
        <target>Das Archiv-Plugin zeigt alle Beiträge nach Jahr und Monat gruppiert.</target>
      </segment>
    </unit>
    <unit id="plugin.blog_sidebar.title">
      <segment>
        <source>Blog: Sidebar</source>
        <target>Blog: Seitenleiste</target>
      </segment>
    </unit>
    <unit id="plugin.blog_sidebar.description">
      <segment>
        <source>The sidebar contains links enabling the user to quickly navigate your blog. It shows an overview of recent posts and comments, categories, tags and archive links.</source>
        <target>Die Seitenleiste enthält Links zur schnellen Navigation im Blog. Sie zeigt neueste Beiträge und Kommentare, Kategorien, Schlagwörter und Archivlinks.</target>
      </segment>
    </unit>
